# Public base URL used when building returned links.
BASE_URL=https://hoard.sharath.page

# Root admin secret: tenant management (/api/tenants) and token minting (>= 16 chars).
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional legacy mode: HMAC key for the single-tenant unprefixed routes
# (/upload, /f/...). Leave unset to run tenant-only. >= 16 chars when set.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# How long files live when no ?ttl= is given. Go duration or Nd (days).
DEFAULT_TTL=72h

# Upper bound for any requested TTL.
MAX_TTL=7d

# Upload size limit in bytes (default 5 GiB).
MAX_UPLOAD_BYTES=5368709120
